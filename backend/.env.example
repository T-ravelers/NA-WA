# 이 파일은 환경 변수 이름을 공유하기 위한 예시이며 애플리케이션이 자동으로 읽지 않습니다.
# 실제 값은 IntelliJ 실행 구성이나 배포 환경의 비밀 저장소에 등록하세요.

# MySQL
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/nawa_local?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DATABASE_USERNAME=nawa
DATABASE_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT_MILLIS=2000
REDIS_KEY_PREFIX=nawa:local:

# JWT와 인증 상태 TTL
# JWT_SECRET에는 32바이트 이상의 난수를 Base64로 인코딩한 값을 입력하세요.
JWT_SECRET=
JWT_ISSUER=nawa
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
OAUTH_STATE_TTL_SECONDS=600

# 인증 쿠키
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token

# 프런트엔드 연동
AUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/auth/callback
AUTH_FRONTEND_FAILURE_URL=http://localhost:5173/auth/callback
AUTH_FRONTEND_ALLOWED_RETURN_PATHS=/
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth 2.0 / OpenID Connect
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
GOOGLE_OAUTH_SCOPES=openid,profile,email

# LINE Login / OpenID Connect
LINE_OAUTH_CLIENT_ID=
LINE_OAUTH_CLIENT_SECRET=
LINE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/line
LINE_OAUTH_SCOPES=openid,profile
