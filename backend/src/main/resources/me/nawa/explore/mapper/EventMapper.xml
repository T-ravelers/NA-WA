<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="me.nawa.explore.mapper.EventMapper">
    <resultMap id="eventDetailResultMap"
               type="me.nawa.explore.dto.response.EventDetailResponse"
               autoMapping="true">
        <result property="imageUrls"
                column="image_urls"
                typeHandler="me.nawa.explore.mapper.JsonNodeTypeHandler"/>
        <result property="links"
                column="links"
                typeHandler="me.nawa.explore.mapper.JsonNodeTypeHandler"/>
        <result property="preReservation"
                column="pre_reservation"
                typeHandler="me.nawa.explore.mapper.JsonNodeTypeHandler"/>
        <result property="operatingHours"
                column="operating_hours"
                typeHandler="me.nawa.explore.mapper.JsonNodeTypeHandler"/>
        <result property="openDays"
                column="open_days"
                typeHandler="me.nawa.explore.mapper.JsonNodeTypeHandler"/>
    </resultMap>

    <!-- Event의 저장 status는 스냅샷 생성 시점 값이므로 현재 종료 여부에는 사용하지 않는다. -->
    <sql id="eventNotEndedCondition">
        (e.end_date IS NULL OR e.end_date &gt;= CURRENT_DATE())
    </sql>

    <!-- 요청한 회원의 찜 여부. 비인증 요청(memberId IS NULL)은 항상 FALSE다. -->
    <sql id="savedColumn">
        <choose>
            <when test="memberId != null">
                EXISTS (
                    SELECT 1
                    FROM explore_item_likes saved_like
                    WHERE saved_like.item_id = ei.item_id
                      AND saved_like.member_id = #{memberId}
                      AND saved_like.deleted_at IS NULL
                ) AS saved
            </when>
            <otherwise>FALSE AS saved</otherwise>
        </choose>
    </sql>

    <select id="findEventDetail"
            resultMap="eventDetailResultMap">
        SELECT
            e.event_id,
            e.event_type,
            e.event_kind,
            e.title,
            e.subtitle,
            e.description,
            e.program_text,
            e.thumbnail_url,
            e.image_urls,
            e.links,
            e.reservation_url,
            e.pre_reservation,
            e.status,
            e.is_permanent,
            e.start_date,
            e.end_date,
            e.operating_hours,
            e.open_days,
            e.open_weekend,
            e.opens_late,
            e.venue_name,
            e.region1,
            e.region2,
            e.region3,
            e.address_road,
            e.latitude,
            e.longitude,
            e.has_photo_zone,
            e.is_experience,
            e.age_limit,
            e.is_free,
            e.price_text,
            e.has_benefit,
            e.reservable,
            e.contact,
            e.organizer,
            <include refid="savedColumn"/>
        FROM explore_items ei
                 JOIN event e
                      ON e.event_id = ei.item_id
        WHERE ei.item_type = 'EVENT'
          AND ei.item_id = #{eventId}
          AND ei.approval_status = 'APPROVED'
          AND ei.visibility_status = 'VISIBLE'
          AND ei.deleted_at IS NULL
          AND e.deleted_at IS NULL
          AND <include refid="eventNotEndedCondition"/>
    </select>

    <select id="findEventActivities"
            resultType="me.nawa.explore.dto.response.EventActivityResponse">
        SELECT
            a.activity_id,
            a.activity_code,
            <!-- TODO(국제화 후속 이슈): activity/sector 다국어 라벨 확장 전까지 en 외에는 한국어를 사용한다. -->
            CASE
                WHEN #{language} = 'en' THEN a.label_en
                ELSE a.label_ko
                END AS activity_name,
            s.sector_id,
            s.sector_code,
            CASE
                WHEN #{language} = 'en' THEN s.label_en
                ELSE s.label_ko
                END AS sector_name,
            ea.is_primary
        FROM event_activity ea
                 JOIN activity a
                      ON a.activity_id = ea.activity_id
                 JOIN sector s
                      ON s.sector_id = a.sector_id
        WHERE ea.event_id = #{eventId}
          AND ea.deleted_at IS NULL
          AND a.deleted_at IS NULL
          AND s.deleted_at IS NULL
        ORDER BY ea.is_primary DESC,
                 s.display_order,
                 a.display_order,
                 a.activity_id
    </select>

    <!-- region2Other는 선택한 region1의 공식 세부지역 목록 밖 데이터를 의미한다. -->
    <sql id="region2OtherCondition">
        (
            e.region2 IS NULL
            OR TRIM(e.region2) = ''
            <if test="request.knownRegion2Values != null and request.knownRegion2Values.size() > 0">
                OR e.region2 NOT IN
                <foreach collection="request.knownRegion2Values" item="knownRegion2"
                         open="(" separator="," close=")">#{knownRegion2}</foreach>
            </if>
        )
    </sql>

    <sql id="eventListWhere">
        ei.item_type = 'EVENT'
        AND ei.approval_status = 'APPROVED'
        AND ei.visibility_status = 'VISIBLE'
        AND ei.deleted_at IS NULL
        AND e.deleted_at IS NULL
        AND <include refid="eventNotEndedCondition"/>

        <if test="request.eventKinds != null and request.eventKinds.size() > 0">
            AND e.event_kind IN
            <foreach collection="request.eventKinds"
                     item="eventKind"
                     open="("
                     separator=","
                     close=")">
                #{eventKind}
            </foreach>
        </if>

        <if test="request.region1 != null and request.region1.size() > 0">
            AND e.region1 IN
            <foreach collection="request.region1"
                     item="region1"
                     open="("
                     separator=","
                     close=")">
                #{region1}
            </foreach>
        </if>
        <choose>
            <when test="request.region2Other == true and request.region1 != null and request.region1.size() > 0 and request.region2 != null and request.region2.size() > 0">
                AND (
                e.region2 IN
                <foreach collection="request.region2"
                         item="region2"
                         open="("
                         separator=","
                         close=")">
                    #{region2}
                </foreach>
                OR <include refid="region2OtherCondition"/>
                )
            </when>
            <when test="request.region2Other == true and request.region1 != null and request.region1.size() > 0">
                AND <include refid="region2OtherCondition"/>
            </when>
            <when test="request.region2Other == true">
                <!-- Other는 부모 region1 없이 전체 지역으로 해석하지 않는다. -->
                AND 1 = 0
            </when>
            <when test="request.region2 != null and request.region2.size() > 0">
                AND e.region2 IN
                <foreach collection="request.region2"
                         item="region2"
                         open="("
                         separator=","
                         close=")">
                    #{region2}
                </foreach>
            </when>
        </choose>
        <if test="request.region3 != null and request.region3.size() > 0">
            AND e.region3 IN
            <foreach collection="request.region3"
                     item="region3"
                     open="("
                     separator=","
                     close=")">
                #{region3}
            </foreach>
        </if>

        <if test="request.keyword != null and request.keyword != ''">
            AND (
            e.title LIKE CONCAT('%', #{request.keyword}, '%')
            OR e.subtitle LIKE CONCAT('%', #{request.keyword}, '%')
            OR e.description LIKE CONCAT('%', #{request.keyword}, '%')
            )
        </if>

        <!-- 날짜 프리셋은 프론트가 사용자 시간대 기준 startDate/endDate로
             환원해 보낸다. 서버 시간대(CURRENT_DATE) 기반 프리셋 분기는
             #275에서 제거했다. -->

        <if test="request.startDate != null">
            AND (e.end_date IS NULL OR e.end_date &gt;= #{request.startDate})
        </if>
        <if test="request.endDate != null">
            AND e.start_date &lt;= #{request.endDate}
        </if>

        <if test="request.freeOnly == true">
            AND e.is_free = TRUE
        </if>
        <if test="request.openWeekendOnly == true">
            AND e.open_weekend = TRUE
        </if>
        <if test="request.opensLateOnly == true">
            AND e.opens_late = TRUE
        </if>
        <if test="request.preReservationOnly == true">
            AND JSON_UNQUOTE(JSON_EXTRACT(e.pre_reservation, '$.has')) = 'true'
        </if>
        <if test="request.experienceOnly == true">
            AND e.is_experience = TRUE
        </if>
        <if test="request.photoZoneOnly == true">
            AND e.has_photo_zone = TRUE
        </if>

        <if test="request.sectorIds != null and request.sectorIds.size() > 0">
            AND EXISTS (
            SELECT 1
            FROM event_activity filter_ea
            JOIN activity filter_a
            ON filter_a.activity_id = filter_ea.activity_id
            WHERE filter_ea.event_id = e.event_id
            AND filter_ea.deleted_at IS NULL
            AND filter_a.deleted_at IS NULL
            AND filter_a.sector_id IN
            <foreach collection="request.sectorIds"
                     item="sectorId"
                     open="("
                     separator=","
                     close=")">
                #{sectorId}
            </foreach>
            )
        </if>
        <if test="request.activityIds != null and request.activityIds.size() > 0">
            AND EXISTS (
            SELECT 1
            FROM event_activity filter_ea
            WHERE filter_ea.event_id = e.event_id
            AND filter_ea.deleted_at IS NULL
            AND filter_ea.activity_id IN
            <foreach collection="request.activityIds"
                     item="activityId"
                     open="("
                     separator=","
                     close=")">
                #{activityId}
            </foreach>
            )
        </if>

        <if test="request.savedOnly == true">
            AND EXISTS (
                SELECT 1
                FROM explore_item_likes saved_like
                WHERE saved_like.item_id = ei.item_id
                  AND saved_like.member_id = #{memberId}
                  AND saved_like.deleted_at IS NULL
            )
        </if>
    </sql>

    <select id="searchEvents"
            resultType="me.nawa.explore.dto.response.EventSummaryResponse">
        SELECT
        e.event_id AS item_id,
        e.event_kind,
        e.status,
        e.title,
        e.subtitle,
        e.thumbnail_url,
        e.region1,
        e.region2,
        e.region3,
        e.latitude,
        e.longitude,
        e.start_date,
        e.end_date,
        <include refid="savedColumn"/>
        FROM explore_items ei
        JOIN event e
        ON e.event_id = ei.item_id
        WHERE
        <include refid="eventListWhere"/>
        <choose>
            <when test="request.sort == 'POPULAR'">
                ORDER BY e.view_count DESC, e.event_id DESC
            </when>
            <when test="request.sort == 'ENDING_SOON'">
                ORDER BY e.end_date IS NULL, e.end_date ASC, e.event_id DESC
            </when>
            <otherwise>
                ORDER BY e.created_at DESC, e.event_id DESC
            </otherwise>
        </choose>
        LIMIT #{request.size}
        OFFSET #{offset}
    </select>

    <select id="countEvents" resultType="long">
        SELECT COUNT(*)
        FROM explore_items ei
        JOIN event e
        ON e.event_id = ei.item_id
        WHERE
        <include refid="eventListWhere"/>
    </select>

</mapper>
