# 부하 테스트용 환경변수. `.env.loadtest`로 복사해 쓴다.
#
# `.env.loadtest`는 gitignore된다. 이 예시 파일만 저장소에 올라간다.

# ── 백엔드(SUT) ────────────────────────────────────────────────────
# 운영 .env와 같은 키를 쓰되 값은 전부 테스트용으로 채운다.
# 아래 MySQL 비밀번호는 이 로컬 전용 컨테이너에만 쓰는 공개 가능한 기본값이다.
# 운영·공유 DB에서 재사용하지 않는다.

MYSQL_ROOT_PASSWORD=loadtest-root
MYSQL_DATABASE=nawa
MYSQL_USER=nawa
MYSQL_PASSWORD=loadtest

DOCKERHUB_USERNAME=loadtest

# JWT_SECRET 은 **Base64로 인코딩된** 32바이트 이상 키여야 한다.
# 평문을 넣으면 기동 시 'Illegal base64 character' 로 컨텍스트가 죽고,
# Tomcat 은 뜨는데 모든 요청이 404 가 되어 원인을 찾기 어렵다.
#   생성: openssl rand -base64 32
JWT_SECRET=
AUTH_FRONTEND_SUCCESS_URL=http://127.0.0.1:5173/auth/callback
AUTH_FRONTEND_FAILURE_URL=http://127.0.0.1:5173/sign-in
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false

# 부하 테스트 로그인 공유 비밀. 아무 값이나 채우면 된다.
# 이 값이 있으면 공유 비밀만으로 임의 회원 로그인이 가능하다.
# 운영 .env에는 절대 넣지 않는다.
#   생성: openssl rand -hex 16
LOADTEST_LOGIN_SECRET=

# ── 외부 서비스 차단 ───────────────────────────────────────────────
# 실제 트래픽이 나가면 과금되거나 실 데이터가 더러워진다.

# `-Ploadtest` 빌드는 Stripe 클라이언트를 로컬 스텁으로 교체하므로 실제 키가 필요 없다.
# 실제 Stripe 키처럼 보이는 값조차 공개 예시 파일에 두지 않는다.
STRIPE_SECRET_KEY=loadtest-disabled
STRIPE_WEBHOOK_SECRET=loadtest-disabled

# 둘 다 비워야 글자 인식 기능이 꺼진다. 하나만 채우면 서버가 기동을 멈춘다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=

# authorization의 302까지만 확인하고 공급자 토큰 교환은 하지 않으므로 더미로 채운다.
GOOGLE_OAUTH_CLIENT_ID=dummy
GOOGLE_OAUTH_CLIENT_SECRET=dummy
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/oauth2/callback/google
LINE_OAUTH_CLIENT_ID=dummy
LINE_OAUTH_CLIENT_SECRET=dummy
LINE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/oauth2/callback/line

# 실 버킷에 테스트 파일이 쌓이지 않게 비워 둔다.
AWS_S3_RECEIPT_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 크롤러 파이프라인 경로는 이번 테스트에서 쓰지 않는다.
PIPELINE_SERVICE_SECRET=
