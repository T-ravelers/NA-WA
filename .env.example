# 로컬 전체 스택 실행에 필요한 루트 환경 변수 예시 파일이다.
#
# 사용 방법:
#   cp -n .env.example .env
#
# 이 파일은 이름과 로컬 기본값을 공유하기 위한 템플릿이다.
# 운영 비밀번호와 OAuth client secret, 운영 JWT secret, Stripe secret은 넣지 않는다.
# 아래 MySQL 값은 로컬 컨테이너 초기화를 위한 공개 가능한 개발용 기본값이다.

# docker-compose.yml의 backend 이미지 이름에 사용하는 네임스페이스다.
# `local`이면 로컬 빌드 이미지가 local/nawa-backend:latest로 태그된다.
# 이미 빌드된 Docker Hub 이미지를 사용하려면 실제 공개 이미지 네임스페이스로 바꾼다.
DOCKERHUB_USERNAME=local

# MySQL 로컬 개발용 설정이다. 이 값들은 로컬 컨테이너에서만 사용한다.
MYSQL_ROOT_PASSWORD=nawa_local_mysql_root_pw
MYSQL_DATABASE=nawa
MYSQL_USER=nawa
MYSQL_PASSWORD=nawa_local_mysql_app_pw

# Redis는 로컬 기본 설정에서 인증 없이 실행한다.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT_MILLIS=2000
REDIS_KEY_PREFIX=nawa:

# 인증 기본 설정이다.
# JWT_SECRET은 실제 로컬 테스트 전에 직접 생성한 32바이트 이상 Base64 secret으로 교체한다.
# 아래 값은 문서 검증용 공개 예시일 뿐, 운영이나 공유 환경에서 재사용하지 않는다.
JWT_SECRET=bG9jYWwtZGV2LXNlY3JldC1yZXBsYWNlLWJlZm9yZS11c2UtMzItYnl0ZXM=
JWT_ISSUER=nawa
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# 크롤러 파이프라인이 적재 엔드포인트를 부를 때 제시하는 공유 비밀.
# 사람 로그인은 OAuth2뿐이라 기계가 토큰을 받을 경로가 없어 따로 둔다.
# 비워 두면 /api/v1/auth/service-token 이 아무 요청도 받지 않는다.
PIPELINE_SERVICE_SECRET=
# V15가 만드는 SYSTEM 회원. 적재된 항목의 등록자로 기록된다.
PIPELINE_MEMBER_ID=1000000
REFRESH_TOKEN_TTL_SECONDS=1209600
OAUTH_STATE_TTL_SECONDS=600

# README의 로컬 주소가 HTTP이므로 쿠키가 브라우저에 전송되도록 Secure를 끈다.
# 운영에서는 HTTPS와 함께 AUTH_COOKIE_SECURE=true를 사용한다.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_OAUTH_STATE_COOKIE_NAME=oauth_state

# OAuth 로그인 완료 후 프론트엔드가 처리하는 콜백 경로다.
AUTH_FRONTEND_SUCCESS_URL=http://localhost:5173/auth/callback
AUTH_FRONTEND_FAILURE_URL=http://localhost:5173/auth/callback
AUTH_FRONTEND_ALLOWED_RETURN_PATHS=/
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth 로컬 개발 설정이다.
# Client ID/Secret은 Google Cloud Console에서 별도로 발급받는다.
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/google
GOOGLE_OAUTH_SCOPES=openid,profile,email

# LINE OAuth 로컬 개발 설정이다.
# Client ID/Secret은 LINE Developers Console에서 별도로 발급받는다.
LINE_OAUTH_CLIENT_ID=replace_with_line_client_id
LINE_OAUTH_CLIENT_SECRET=replace_with_line_client_secret
LINE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/line
LINE_OAUTH_SCOPES=openid,profile

# OAuth 공급자와 통신할 때 사용하는 타임아웃(ms)이다.
OAUTH_HTTP_CONNECT_TIMEOUT_MILLIS=3000
OAUTH_HTTP_READ_TIMEOUT_MILLIS=5000

# Stripe 테스트 환경 설정이다.
# 실제 test mode key와 webhook secret은 Stripe Dashboard에서 별도로 발급받는다.
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# 영수증 사진에서 품목 글자를 읽는 네이버 CLOVA OCR 설정이다.
# Invoke URL과 Secret Key는 NCP 콘솔에서 영수증(Receipt) 도메인을 만들면 그 도메인 전용으로
# 함께 나온다. 그래서 둘은 항상 한 쌍이며, 하나만 채우면 서버가 아예 뜨지 않는다. 안 막으면
# 사용자가 영수증을 찍는 순간에야 실패해서 원인을 찾기 어렵다.
# 둘 다 비워두면 글자 인식 기능만 꺼지므로, 이 기능을 안 쓰는 로컬 실행은 값 없이도 된다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET_KEY=

# 글자 인식 서버를 기다리는 시간(ms)이다. 읽기 쪽이 OAuth(5초)보다 긴 이유는 사진을 실제로
# 분석하는 시간이 들어가기 때문이다. 짧게 잡으면 정상 요청도 시간 초과로 끊긴다.
CLOVA_OCR_CONNECT_TIMEOUT_MILLIS=3000
CLOVA_OCR_READ_TIMEOUT_MILLIS=10000

# 정산 영수증 이미지용 S3 설정이다.
# 버킷은 백엔드가 도는 계정과 다른 AWS 계정이 소유하므로, 인스턴스 역할이 아니라
# 버킷 소유 계정에서 발급한 IAM 사용자 키를 쓴다. 키는 팀 비공개 채널로 받아 .env에만 넣는다.
# 키 두 개를 모두 비워두면 AWS 라이브러리가 알아서 다른 곳에서 열쇠를 찾으므로,
# 영수증 기능을 안 쓰는 로컬 실행은 값 없이도 된다.
# 반대로 한 짝만 채우면 서버가 아예 뜨지 않는다. 안 막으면 서버는 멀쩡히 뜬 것처럼
# 보이다가 영수증을 처음 올릴 때 "권한 없음"으로 실패해 원인 찾기가 어렵기 때문이다.
AWS_REGION=ap-northeast-2
AWS_S3_RECEIPT_BUCKET=replace_with_receipt_bucket_name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 영수증 사진 한 장의 최대 크기(바이트)다. 비워두면 8MB를 쓴다.
# 이 값을 올리면 nginx의 client_max_body_size도 함께 올려야 한다. nginx가 더 작으면
# 요청이 백엔드에 닿기도 전에 잘려서 앱이 오류 코드를 돌려줄 기회조차 없다.
RECEIPT_MAX_UPLOAD_BYTES=8388608
