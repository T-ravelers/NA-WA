{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
  "enabledManagers": ["npm"],
  "timezone": "Asia/Seoul",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "dependencyDashboard": true,
  "automerge": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "frontend",
  "packageRules": [
    {
      "description": "Node·pnpm 버전은 AGENTS.md가 고정한다. 사람이 직접 올린다.",
      "matchDepTypes": ["engines", "packageManager"],
      "enabled": false
    },
    {
      "description": "@types/node는 런타임 Node 24에 맞춘다.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "minor·patch는 주 1회 PR 하나로 묶는다.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend non-major dependencies"
    },
    {
      "description": "prettier는 포맷 결과가 바뀌면 format:check가 묶음 PR 전체를 막으므로 따로 올린다.",
      "matchPackageNames": ["prettier"],
      "groupName": null
    },
    {
      "description": "major는 Dependency Dashboard에서 승인한 것만 PR로 만든다.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
